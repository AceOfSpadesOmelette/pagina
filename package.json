{
	"name": "pagina",
	"version": "1.0.0",
	"description": "Pagina: export notes to PDF on desktop and mobile, with page size, margins, headers, and footers.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"pagina",
		"pdf"
	],
	"license": "MIT",
	"dependencies": {
		"@pdf-lib/fontkit": "^1.1.1",
		"html2canvas": "^1.4.1",
		"jspdf": "^3.0.1",
		"pdf-lib": "^1.17.1"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^5.8.3"
	}
}
